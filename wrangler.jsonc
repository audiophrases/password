// wrangler.jsonc — deploys the OPTIONAL cloud relay (relay/worker.js) plus the
// static site to Cloudflare's free tier. Not needed for normal local play —
// see README "Cloud relay".
//
//   npx wrangler login     (once — opens the browser)
//   npx wrangler deploy    (prints your https://password-game.<you>.workers.dev URL)
//
// Local testing: npx wrangler dev --persist-to "$TEMP/pw-relay-state"
// (state must live OUTSIDE the repo — the assets watcher reload-loops otherwise)
{
  "name": "password-game",
  "main": "relay/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": ".",
    // /api/* must reach the Worker for every method, not just for paths that
    // happen to match no file. Scoped deliberately: making the Worker run first
    // for everything would bill every page load, while static assets are free.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RelayRoom" },
      { "name": "LIBRARY", "class_name": "Library" }
    ]
  },
  // A migration tag records what has already been applied, so "Library" cannot
  // be added to v1 — v1 will never run again. Appending v2 is non-destructive
  // and leaves RelayRoom and its data alone.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Library"] }
  ],
  "observability": { "enabled": true }
}
